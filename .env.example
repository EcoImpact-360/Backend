DB_USERNAME=postgres
DB_PASSWORD=tu_password

# Opcionales: solo hace falta tocarlos si tu Postgres no corre en
# localhost:5432 con la base ecoimpact_db (p.ej. dentro de Docker,
# donde DB_HOST suele ser el nombre del servicio, no "localhost").
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=ecoimpact_db
# SERVER_PORT=8080
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Pon DB_SSLMODE=require si tu Postgres exige TLS (Neon, Supabase y la
# mayoria de proveedores gestionados externos a Render lo exigen).
# DB_SSLMODE=disable

# Clave para firmar los tokens de sesion de los colegios (login).
# OBLIGATORIO cambiarla por un valor propio y secreto en produccion;
# si no se define, cae en un valor de desarrollo fijo e inseguro.
TOKEN_SECRET=dev-only-secret-change-in-production
